<?xml version="1.0" encoding="utf-8"?>
<!--
  "Local install" publish profile.
  Publishing with this profile (Visual Studio: Build > Publish, or
  `dotnet publish src/EarlyAccessTracker.App -p:PublishProfile=LocalInstall`):
    1. Stops any running EarlyAccessTracker.exe so its files aren't locked.
    2. Publishes a Release build to %LOCALAPPDATA%\Programs\EarlyAccessTracker.
    3. Runs scripts\Install-ScheduledTask.ps1 -SkipPublish -StartNow, which (re)registers the
       "Early Access Tracker" scheduled task and starts the app in the tray.
  Equivalent to running scripts\Install-ScheduledTask.ps1 -StartNow by hand.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishUrl>$(LOCALAPPDATA)\Programs\EarlyAccessTracker\</PublishUrl>
    <PublishDir>$(PublishUrl)</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>

    <_EatInstallScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\scripts\Install-ScheduledTask.ps1'))</_EatInstallScript>
    <_EatInstallDir>$(PublishUrl.TrimEnd('\'))</_EatInstallDir>
  </PropertyGroup>

  <!-- The tray app keeps its exe/dlls locked while running. -->
  <Target Name="EatStopRunningApp" BeforeTargets="PrepareForPublish">
    <Message Importance="high" Text="Stopping running Early Access Tracker (if any)..." />
    <Exec Command="taskkill /IM EarlyAccessTracker.exe /F" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <!-- Give Windows a moment to release file handles. -->
    <Exec Command="powershell -NoProfile -Command &quot;Start-Sleep -Milliseconds 750&quot;" />
  </Target>

  <!-- AfterPublish (not Publish): in VS, Publish only fills obj\...\PubTmp; files reach PublishUrl later via FileSystemPublish. -->
  <!-- Pass -p:EatSkipInstall=true to publish the files only (no task registration / launch). -->
  <Target Name="EatRegisterScheduledTask" AfterTargets="AfterPublish" Condition="'$(EatSkipInstall)' != 'true'">
    <Message Importance="high" Text="Registering scheduled task and starting the tray app..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_EatInstallScript)&quot; -SkipPublish -StartNow -InstallDir &quot;$(_EatInstallDir)&quot;" />
  </Target>
</Project>
